# Horror Movie Quote Video Generator - Environment Variables
# Copy this file to .env and fill in your actual values.
# Secrets only -- everything else (quote count, backends, privacy status,
# etc.) lives in config.yaml now.

# OpenAI API Configuration (quote generation + image fallback path)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs Music API key (music.backend: elevenlabs in config.yaml)
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
# This is a separate subscription/spend from OpenAI -- see README for
# current per-minute pricing before enabling this.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Notes:
# - Never commit the actual .env file to version control.
# - Keep your API keys secure and never share them.
# - YouTube upload uses client_secret.json / token.json (see README's
#   "Unattended YouTube upload" section), not an env var.
